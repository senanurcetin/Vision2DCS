{
  "name": "vision2dcs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr server/start.ts --outDir dist-server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist-server/start.js",
    "eval": "vite-node eval/run.ts",
    "eval:compare": "vite-node eval/compare-cli.ts",
    "eval:preflight": "vite-node eval/preflight-cli.ts",
    "eval:inspect": "vite-node eval/inspect-cli.ts",
    "eval:diagnose": "vite-node eval/diagnostics-cli.ts",
    "eval:ocr": "vite-node eval/ocr-cli.ts",
    "eval:compare-tags": "vite-node eval/compare-tags-cli.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
