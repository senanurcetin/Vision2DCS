# Copy to .env.local (git-ignored) and fill in. Read only by the server
# (vite dev/preview middleware or `npm start`); never sent to the browser.
# GEMINI_API_KEY alone does NOT enable billable endpoints.
GEMINI_API_KEY=
VISION2DCS_ENABLE_AI=false
# Generate a random 32+ character secret for authenticated AI requests.
# Never commit actual access tokens.
# VISION2DCS_AI_ACCESS_TOKEN=

# Optional model overrides
# GEMINI_ANALYSIS_MODEL=gemini-3-flash-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
